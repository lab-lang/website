{
  "redirects": [
    {
      "source": "/why/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/playground/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/community/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/brand",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
